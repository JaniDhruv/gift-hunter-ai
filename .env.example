# Reserved for planned MongoDB persistence; not used by the current app.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Google AI Studio Gemma is the default when this key is present.
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMMA_PROVIDER=google
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Optional alternative provider.
NVIDIA_NIM_API=your_nvidia_nim_api_key_here
NVIDIA_MODEL=google/gemma-4-31b-it

# SerpApi key enables live shopping automatically when present.
SERPAPI_KEY=your_serpapi_key_here

# Set either flag to false to explicitly disable an integration.
# ENABLE_NVIDIA_NIM=false
# ENABLE_LIVE_SHOPPING=false
